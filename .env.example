# Orcha environment settings
# The offline engine requires no API keys.
# Never commit real credentials.

# Optional overrides; CLI arguments take precedence.
DATASET_DIR=demo/dataset
OUTPUT_CSV=.local/demo-output.csv
LOG_LEVEL=INFO

# Google AI Studio: used only by the explicit --assist command.
# Put your real key in .env or the process environment, not in this example.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=45
GEMMA_MAX_OUTPUT_TOKENS=4096

# Optional local extraction cache. Contains source quotes; keep it private.
# GEMMA_CACHE_DIR=.local/gemma-cache

# Optional InstaCloud Laya routing. Send workflow flags only; never financial text.
# Keep the service token private. Missing/unavailable routing uses the local fallback.
LAYA_API_URL=
LAYA_API_TOKEN=
LAYA_TIMEOUT_SECONDS=8
# Total bounded wait after an explicit model-loading response on a cold start.
LAYA_STARTUP_TIMEOUT_SECONDS=45
LAYA_MIN_CONFIDENCE=0.8
